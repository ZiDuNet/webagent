# =============================================================================
# WebAgent 环境变量模板
# 复制为 .env 后按部署环境修改；支持 `npm run init:env` 生成随机密钥。
# 写法：每行 KEY=VALUE，不加引号、不写 export。值区分大小写。
# 分组：服务 / 安全与登录 / 存储 / 运行与工具 / 模型元数据 / PC4D 业务接入 / 开发调试
# =============================================================================

# ==================== 服务 ====================
# 后端监听地址。127.0.0.1 = 仅本机访问；容器或对外服务改为 0.0.0.0。默认 127.0.0.1。
WEBAGENT_BIND_HOST=127.0.0.1
# 后端 HTTP 端口，同时提供 API、/admin/ 与 /chat/。默认 8000。
WEBAGENT_PORT=8000
# 是否由后端托管管理端静态文件。1 开启，0 关闭（前后端分离部署时关闭）。默认 1。
WEBAGENT_SERVE_ADMIN=1
# 是否由后端托管 Chat 静态文件。1 开启，0 关闭。默认 1。
WEBAGENT_SERVE_CHAT=1
# 浏览器跨域写入白名单：逗号分隔的完整 Origin（协议://主机:端口，不带结尾斜杠，不支持 *）。
# 同时用于跨站写请求校验和 PC4D 渠道的 CORS 响应头。默认空 = 仅允许同源。
WEBAGENT_UI_ORIGINS=https://agent.example.com

# ==================== 安全与登录 ====================
# 凭据加密根密钥（AES-GCM），用于加密供应商 Key、接入 Token 和 PC4D 短期凭据。
# 必须是 32 字节以上随机值（可用 `npm run init:env` 生成）；丢失后已保存的 Key/Token 无法解密。
WEBAGENT_SECRET_KEY=replace-with-a-random-32-byte-secret
# 管理端 admin 账号的初始密码，仅在首次创建账号时生效。默认 admin123（生产必须修改）。
WEBAGENT_CONTROL_PASSWORD=replace-with-a-unique-management-password
# 恢复开关：设为 1 时，本次启动把 admin 密码重置为上面的值并撤销全部管理会话；
# 恢复后必须改回 0 或删除该行。默认 0（关闭）。
WEBAGENT_RESET_CONTROL_PASSWORD=0
# 管理端会话 Cookie 是否仅通过 HTTPS 发送。本机 HTTP 用 0，HTTPS 部署必须为 1。默认 0。
WEBAGENT_COOKIE_SECURE=0
# 管理端登录有效期（小时）。默认 24。
WEBAGENT_SESSION_HOURS=24

# ==================== 存储 ====================
# 单一数据根目录：配置、会话、上传、Skill 与运行时 SQLite 都在其下。
# 相对路径基于仓库根目录（不是当前工作目录）。默认 ./data。
WEBAGENT_DATA_DIR=./data
# `npm run migrate` 读取的旧库源目录，仅在迁移旧数据时使用。默认 ./legacy。
WEBAGENT_LEGACY_DIR=./legacy
# 兼容别名：仅当未设置 WEBAGENT_DATA_DIR 时作为回退读取，新部署不要使用。默认 data。
# WEBAGENT_PI_DATA_DIR=./data

# ==================== 运行与工具 ====================
# 是否允许 stdio MCP（会在后端主机启动子进程）。1 仅用于完全信任的部署；默认 0。
WEBAGENT_ALLOW_STDIO=0
# PI 本机执行工具的部署级锁：off = 全部锁定（默认）；admin = 解锁定义，
# 仍需管理员在工具页逐项启用，且没有沙箱，只适合受信任的单租户部署。
WEBAGENT_LOCAL_TOOLS=off

# ==================== 模型元数据 ====================
# models.dev 元数据地址；无法直连时可改为镜像或本地 JSON 文件地址。默认 https://models.dev/api.json。
WEBAGENT_MODELSDEV_URL=https://models.dev/api.json
# 拉取 models.dev 的超时时间（秒）。默认 120。
WEBAGENT_MODELSDEV_TIMEOUT_SECONDS=120

# ==================== PC4D 业务接入 ====================
# 是否以 PC4D 业务连接器模式启动（挂载 /api/integrations/pc4d/* 与业务身份适配器）。
# 只有精确值 1 开启，0 关闭（true/yes 不生效）。默认 0。
WEBAGENT_PC4D_ENABLED=0
# PC4D 业务 API 根地址，必须是 http(s) 根地址且不能带路径。默认 https://cloud.4dbim.vip。
WEBAGENT_PC4D_BASE_URL=https://cloud.4dbim.vip
# 客户端可访问的 Agent 公网根地址，仅用于生成 HTML 预览的绝对链接；留空返回同源相对路径。默认空。
WEBAGENT_PC4D_PUBLIC_URL=
# PC4D 短期凭据有效期（小时，范围 1/60–24）。默认 2。
WEBAGENT_PC4D_TOKEN_HOURS=2
# PC4D 业务权限缓存时间（秒，范围 0–60）。默认 10。
WEBAGENT_PC4D_PERMISSION_CACHE_SECONDS=10
# 重要：大屏 / Web / 小程序渠道由管理端「接入与安全」中的渠道 Token 绑定，
# 不使用任何 PID 白名单环境变量；任意正整数 pid 均可换取该渠道凭据（server 端会在调用业务接口时校验项目数据）。

# ==================== 开发调试 ====================
# 启动时是否后台预热 models.dev 缓存（仅影响启动网络请求，不阻塞监听）。1 开启，0 关闭。默认 1。
# 本地离线调试可设为 0，避免启动时访问外网。
WEBAGENT_MODELSDEV_WARMUP=1

# 兼容别名：仅当未设置 WEBAGENT_SECRET_KEY 时作为回退读取，新部署不要使用。
# WEBAGENT_INTERNAL_SECRET=
