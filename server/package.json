{
  "name": "@webagent/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/sdk.js" },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "migrate": "node --env-file-if-exists=../.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "fastify": "^5.6.2",
    "typebox": "^1.0.63",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
